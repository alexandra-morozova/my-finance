{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "node --watch --env-file=.env --env-file-if-exists=.env.local src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run",
    "test:integration": "node --env-file=.env --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run tests/integration",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jose": "^6.2.12",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "22",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
